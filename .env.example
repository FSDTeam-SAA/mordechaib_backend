NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000

MONGO_URI=mongodb://localhost:27017/noltra

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REMEMBER_ME_REFRESH_TOKEN_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_IN=1h
EMAIL_VERIFICATION_EXPIRES_IN=24h
BCRYPT_ROUNDS=12
AUTH_EXPOSE_DEVELOPMENT_TOKENS=true

FRONTEND_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Noltra AI <no-reply@noltra.ai>
SUPPORT_EMAIL=support@example.com

# The SMTP_* names above are preferred. These EMAIL_* aliases are also
# supported for compatibility with existing deployments.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_ADDRESS=
# EMAIL_PASS=
# EMAIL_FROM=

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15555555555

OPENAI_API_KEY=sk-your-openai-key
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# Meta / Facebook Login for Business (development mode)
META_APP_ID=1072322945233880
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/meta/callback
META_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Recall.ai meeting bots (Zoom and Google Meet)
# Recall.ai Zoom meeting bot
RECALLAI_API_KEY=
RECALLAI_WEBHOOK_SECRET=whsec_replace_me
RECALLAI_REGION=us-west-2
RECALLAI_API_BASE_URL=https://us-west-2.recall.ai
RECALLAI_BOT_NAME=Noltra AI Notetaker
RECALLAI_TRANSCRIPTION_MODE=POST_MEETING
RECALLAI_RECORDING_OUTPUT=TRANSCRIPT_AND_AUDIO
RECALLAI_RETENTION_HOURS=168
RECALLAI_CONSENT_MESSAGE=This meeting is being recorded and transcribed by Noltra AI.
RECALLAI_SIGNED_IN_ZOOM=true
RECALLAI_MAX_CONCURRENT_MEETINGS=100
RECALLAI_MAX_CONCURRENT_MEETINGS_PER_ORG=10
RECALLAI_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters

# Optional signed-in Google Meet bot. Leave empty for manual guest-bot testing.
RECALLAI_GOOGLE_MEET_LOGIN_GROUP_ID=

# Runtime Zoom values used to authorize the dedicated signed-in bot account.
# The Zoom client secret and webhook secret are entered in Recall's Zoom OAuth
# App setup; this backend deliberately does not store them.
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_REDIRECT_URI=https://your-ngrok-or-render-domain/api/v1/zoom-meetings/oauth/callback
RECALLAI_ZOOM_OAUTH_APP_ID=

# BullMQ. Use a local Redis URL for ngrok testing and Render Key Value's
# internal URL when deployed on Render.
REDIS_URL=redis://127.0.0.1:6379

TRANSCRIPT_STORAGE=MONGODB
AUDIO_STORAGE_PROVIDER=RECALL

# Organizer-connected meeting platforms (Phase 1; no calendar auto-sync).
MEETING_INTEGRATIONS_FRONTEND_URL=http://localhost:3000/dashboard/integrations
MEETING_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
MEETING_DEFAULT_TIMEZONE=Asia/Dhaka
MEETING_DEFAULT_DURATION_MINUTES=30

# Google OAuth is used only to create Google Calendar events with Meet links.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-public-backend/api/v1/google-meetings/oauth/callback
