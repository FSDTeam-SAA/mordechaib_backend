NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

MONGO_URI=mongodb://localhost:27017/noltra

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REMEMBER_ME_REFRESH_TOKEN_EXPIRES_IN=30d
PASSWORD_RESET_EXPIRES_IN=1h
EMAIL_VERIFICATION_EXPIRES_IN=24h
BCRYPT_ROUNDS=12
AUTH_EXPOSE_DEVELOPMENT_TOKENS=true

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Noltra AI <no-reply@noltra.ai>
SUPPORT_EMAIL=support@example.com
RECORDING_STORAGE_DIR=./storage/recordings

# Legacy mail aliases supported by configuration.ts:
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USER=
# EMAIL_ADDRESS=
# EMAIL_PASS=
# EMAIL_FROM=

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+15555555555
TWILIO_LIVE_MODE=false
# Temporary non-production test switch. Keep true for staging/production.
TWILIO_SUBSCRIPTION_ENFORCEMENT_ENABLED=true
TWILIO_ALLOWED_CALL_PREFIXES=+1,+33,+44
TWILIO_MAX_OVERAGE_USD_PER_PERIOD=100
TWILIO_NUMBER_RETENTION_DAYS=30
TWILIO_UNUSUAL_CALL_MINUTES=60

# Private message attachments. CLOUDINARY_URL may be used instead of the
# three individual credential variables.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MESSAGE_FOLDER=noltra/messages
CLOUDINARY_DOWNLOAD_URL_TTL_SECONDS=300

OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/meta/callback
META_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters

INTEGRATION_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Recall.ai meeting bot, audio, transcript, and webhook configuration.
RECALLAI_API_KEY=
RECALLAI_WEBHOOK_SECRET=whsec_replace_me
RECALLAI_REGION=us-west-2
RECALLAI_API_BASE_URL=https://us-west-2.recall.ai
RECALLAI_BOT_NAME=Noltra AI Notetaker
RECALLAI_TRANSCRIPTION_MODE=POST_MEETING
RECALLAI_RECORDING_OUTPUT=TRANSCRIPT_AND_AUDIO
RECALLAI_RETENTION_HOURS=168
RECALLAI_CONSENT_MESSAGE=This meeting is being recorded and transcribed by Noltra AI.
RECALLAI_SIGNED_IN_ZOOM=true
RECALLAI_MAX_CONCURRENT_MEETINGS=100
RECALLAI_MAX_CONCURRENT_MEETINGS_PER_ORG=10
RECALLAI_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
RECALLAI_GOOGLE_MEET_LOGIN_GROUP_ID=

# Zoom OAuth uses Recall-managed OAuth credentials and signed-in bot ZAK.
ZOOM_OAUTH_CLIENT_ID=
ZOOM_OAUTH_REDIRECT_URI=https://your-public-backend/api/v1/zoom-meetings/oauth/callback
RECALLAI_ZOOM_OAUTH_APP_ID=

REDIS_URL=redis://127.0.0.1:6379
TRANSCRIPT_STORAGE=MONGODB
AUDIO_STORAGE_PROVIDER=RECALL

# Organization-level meeting and calendar defaults.
MEETING_INTEGRATIONS_FRONTEND_URL=http://localhost:3000/dashboard/integrations
MEETING_OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
MEETING_DEFAULT_TIMEZONE=Asia/Dhaka
MEETING_DEFAULT_DURATION_MINUTES=30
MEETING_DEFAULT_REMINDER_MINUTES=15

# Google Calendar + Google Meet OAuth. Enable both Calendar API and Meet REST API.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-public-backend/api/v1/google-meetings/oauth/callback

# Microsoft personal and multi-tenant work/school Outlook Calendar OAuth.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=https://your-public-backend/api/v1/calendar/outlook/oauth/callback
